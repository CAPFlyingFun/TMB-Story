# Copy to .env.local (git-ignored) or, better, export in your shell instead.
# NEVER commit a real key. This file holds no value on purpose.
#
#   export ELEVENLABS_API_KEY=your-key-here
#   python3 scripts/audio.py generate --chapters 1
#
# In CI the key comes from the ELEVENLABS_API_KEY repository secret, which the
# .github/workflows/audio-generate.yml workflow passes to the process environment.
ELEVENLABS_API_KEY=
