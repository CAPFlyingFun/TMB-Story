      ]
    },
    {
      "lineId": "system-0fe0cf2a5742",
      "character": "system",
      "characterName": "TOMBS / settlement systems",
      "kind": "system",
      "text": "Request denied.",
      "audio": "audio/clips/system/system-0fe0cf2a5742.mp3",
