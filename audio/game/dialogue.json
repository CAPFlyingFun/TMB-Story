{
  "_comment": "Canonical character and system voice lines for the game. Narration is excluded because it is audiobook-only. `audio` points at the same clip the audiobook plays: one generated line, used in both places.",
  "lineCount": 88,
  "lines": [
    {
      "lineId": "system-2e8d8d3e2911",
      "character": "system",
      "characterName": "TOMBS / settlement systems",
      "kind": "system",
      "text": "Warning. unauthorized system access.",
      "audio": "audio/clips/system/system-2e8d8d3e2911.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-2b8704441765",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "What? Okay, I'm awake.",
      "audio": "audio/clips/jack/jack-bennett-2b8704441765.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-85dfddc7134b",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "That's not good.",
      "audio": "audio/clips/jack/jack-bennett-85dfddc7134b.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-492f4059781a",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Come on. What are you doing?",
      "audio": "audio/clips/jack/jack-bennett-492f4059781a.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-b9c31e4c82cf",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "No. Where'd you go?",
      "audio": "audio/clips/jack/jack-bennett-b9c31e4c82cf.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "system-610b0d021f1b",
      "character": "system",
      "characterName": "TOMBS / settlement systems",
      "kind": "system",
      "text": "Security protocol violation.",
      "audio": "audio/clips/system/system-610b0d021f1b.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-549daf1f1de8",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Okay. Definitely awake now.",
      "audio": "audio/clips/jack/jack-bennett-549daf1f1de8.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-27b114bdd284",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "That's impossible.",
      "audio": "audio/clips/jack/jack-bennett-27b114bdd284.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "system-a6ce88995aab",
      "character": "system",
      "characterName": "TOMBS / settlement systems",
      "kind": "system",
      "text": "Tombs project.",
      "audio": "audio/clips/system/system-a6ce88995aab.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-ecf78584ec95",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Oh, no you don't.",
      "audio": "audio/clips/jack/jack-bennett-ecf78584ec95.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-2ffc77da7b3f",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Well, that's new.",
      "audio": "audio/clips/jack/jack-bennett-2ffc77da7b3f.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-a8a6aa7ae3b3",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Sarah?",
      "audio": "audio/clips/jack/jack-bennett-a8a6aa7ae3b3.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-45ac1e9fe1de",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Sarah, you there?",
      "audio": "audio/clips/jack/jack-bennett-45ac1e9fe1de.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-3f51406be04d",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "I'm here,",
      "audio": "audio/clips/sarah/sarah-bennett-3f51406be04d.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-0df3f0a6bee0",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "What's wrong?",
      "audio": "audio/clips/sarah/sarah-bennett-0df3f0a6bee0.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-3141593a1c9d",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I've got something weird on my computer. It tripped a security alarm.",
      "audio": "audio/clips/jack/jack-bennett-3141593a1c9d.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-c0ca574b594a",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "Define weird.",
      "audio": "audio/clips/sarah/sarah-bennett-c0ca574b594a.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-a376700976d7",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I think somebody's in the system.",
      "audio": "audio/clips/jack/jack-bennett-a376700976d7.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-81ff0dc894cf",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "Are you sure?",
      "audio": "audio/clips/sarah/sarah-bennett-81ff0dc894cf.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-3d94cfec7c01",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "No. That's why I'm calling the smarter scientist.",
      "audio": "audio/clips/jack/jack-bennett-3d94cfec7c01.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-5a071d01be77",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "Good answer.",
      "audio": "audio/clips/sarah/sarah-bennett-5a071d01be77.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-632f5041e805",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Can you come take a look?",
      "audio": "audio/clips/jack/jack-bennett-632f5041e805.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-2a350447dd17",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "I'm on my way,",
      "audio": "audio/clips/sarah/sarah-bennett-2a350447dd17.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-31ac40401ca8",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Who are you?",
      "audio": "audio/clips/jack/jack-bennett-31ac40401ca8.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "system-49a4bf38c005",
      "character": "system",
      "characterName": "TOMBS / settlement systems",
      "kind": "system",
      "text": "Boundary control.",
      "audio": "audio/clips/system/system-49a4bf38c005.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-9b850bb838a8",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "No, no, no.",
      "audio": "audio/clips/jack/jack-bennett-9b850bb838a8.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-41421ed41839",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "Please tell me you didn't break something.",
      "audio": "audio/clips/sarah/sarah-bennett-41421ed41839.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-6aa0f73ed972",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I was asleep,",
      "audio": "audio/clips/jack/jack-bennett-6aa0f73ed972.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-e240820580d9",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "You called me in here to admit that?",
      "audio": "audio/clips/sarah/sarah-bennett-e240820580d9.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-1ecaa1e81e25",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "No. That was my defense.",
      "audio": "audio/clips/jack/jack-bennett-1ecaa1e81e25.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-da6d3f2466a2",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "Against what?",
      "audio": "audio/clips/sarah/sarah-bennett-da6d3f2466a2.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-ab5acb662fb5",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Whatever this is.",
      "audio": "audio/clips/jack/jack-bennett-ab5acb662fb5.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-68873cb0ae3a",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I was reviewing yesterday's test results.",
      "audio": "audio/clips/jack/jack-bennett-68873cb0ae3a.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-ecb1ce66f7bc",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "You were sleeping,",
      "audio": "audio/clips/sarah/sarah-bennett-ecb1ce66f7bc.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-fa0505b74e44",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I was reviewing them internally.",
      "audio": "audio/clips/jack/jack-bennett-fa0505b74e44.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-d26997d1aa80",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "With your eyes closed?",
      "audio": "audio/clips/sarah/sarah-bennett-d26997d1aa80.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-050e0785c171",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "It's an advanced technique.",
      "audio": "audio/clips/jack/jack-bennett-050e0785c171.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-ea3f24b4acf1",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "Jack.",
      "audio": "audio/clips/sarah/sarah-bennett-ea3f24b4acf1.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-06415c9f30d8",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Right. Problem.",
      "audio": "audio/clips/jack/jack-bennett-06415c9f30d8.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-eb7b0cfc9b60",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I got an unauthorized access warning. I checked the network monitor and saw a connection I didn't recognize, but it disappeared before I could trace it.",
      "audio": "audio/clips/jack/jack-bennett-eb7b0cfc9b60.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-d446f7575941",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "And then?",
      "audio": "audio/clips/sarah/sarah-bennett-d446f7575941.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-4b4b13be3859",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "It opened the TOMBS directory.",
      "audio": "audio/clips/jack/jack-bennett-4b4b13be3859.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-65056aba0745",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "By itself?",
      "audio": "audio/clips/sarah/sarah-bennett-65056aba0745.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-d97b90a6d54e",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Yep.",
      "audio": "audio/clips/jack/jack-bennett-d97b90a6d54e.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-a1dc5fafa6a9",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "You locked the terminal?",
      "audio": "audio/clips/sarah/sarah-bennett-a1dc5fafa6a9.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-1ebe0c684d41",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "And?",
      "audio": "audio/clips/sarah/sarah-bennett-1ebe0c684d41.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-92ce22fee124",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "It unlocked itself.",
      "audio": "audio/clips/jack/jack-bennett-92ce22fee124.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-9cc3304964a3",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I know.",
      "audio": "audio/clips/jack/jack-bennett-9cc3304964a3.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-dc74b2a7f99a",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "Move.",
      "audio": "audio/clips/sarah/sarah-bennett-dc74b2a7f99a.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-01f2a89496de",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I'm sitting here.",
      "audio": "audio/clips/jack/jack-bennett-01f2a89496de.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-a7934bd42c67",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "Then move your chair.",
      "audio": "audio/clips/sarah/sarah-bennett-a7934bd42c67.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-6d611e695fd8",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Oh.",
      "audio": "audio/clips/jack/jack-bennett-6d611e695fd8.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-ad67f921e02e",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "You said the connection disappeared?",
      "audio": "audio/clips/sarah/sarah-bennett-ad67f921e02e.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-f3736d27f9d7",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Almost immediately.",
      "audio": "audio/clips/jack/jack-bennett-f3736d27f9d7.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-563ad9289e68",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "External?",
      "audio": "audio/clips/sarah/sarah-bennett-563ad9289e68.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-211b122503c9",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I couldn't tell.",
      "audio": "audio/clips/jack/jack-bennett-211b122503c9.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-6fe63af821c3",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "That's reassuring.",
      "audio": "audio/clips/sarah/sarah-bennett-6fe63af821c3.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-2a98eedf112f",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I thought so.",
      "audio": "audio/clips/jack/jack-bennett-2a98eedf112f.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-5965a9732934",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "These are clean,",
      "audio": "audio/clips/sarah/sarah-bennett-5965a9732934.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-e42d2e1230ff",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Exactly.",
      "audio": "audio/clips/jack/jack-bennett-e42d2e1230ff.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-7cb92747650b",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "Too clean.",
      "audio": "audio/clips/sarah/sarah-bennett-7cb92747650b.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-6de493fd3169",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "That's what I was thinking.",
      "audio": "audio/clips/jack/jack-bennett-6de493fd3169.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-deff6b10a48b",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "No, you were sleeping.",
      "audio": "audio/clips/sarah/sarah-bennett-deff6b10a48b.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-29c879a5b799",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I was thinking eventually.",
      "audio": "audio/clips/jack/jack-bennett-29c879a5b799.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-e61a5b7e36cd",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "You know, you're supposed to be resting.",
      "audio": "audio/clips/jack/jack-bennett-e61a5b7e36cd.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-e9ec137bc087",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "So are you.",
      "audio": "audio/clips/sarah/sarah-bennett-e9ec137bc087.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-c1ff018af109",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I'm not the pregnant one.",
      "audio": "audio/clips/jack/jack-bennett-c1ff018af109.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-4db8c4b299cf",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "No. You're the one I found asleep at a laboratory terminal.",
      "audio": "audio/clips/sarah/sarah-bennett-4db8c4b299cf.mp3",
      "chapters": [
        1
      ]
    },
