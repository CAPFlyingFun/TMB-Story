      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "That's different.",
      "audio": "audio/clips/jack/jack-bennett-48aebe4e6970.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-0e24152e8551",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "How?",
      "audio": "audio/clips/sarah/sarah-bennett-0e24152e8551.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-753cad07ca15",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "I wasn't uncomfortable?",
      "audio": "audio/clips/jack/jack-bennett-753cad07ca15.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-941e93bf213e",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Fair.",
      "audio": "audio/clips/jack/jack-bennett-941e93bf213e.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-dc90fc8720b4",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "Lately the baby seems to think eleven at night is morning.",
      "audio": "audio/clips/sarah/sarah-bennett-dc90fc8720b4.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "jack-bennett-a8fc65386727",
      "character": "jack-bennett",
      "characterName": "Jack Bennett",
      "kind": "character",
      "text": "Already takes after me.",
      "audio": "audio/clips/jack/jack-bennett-a8fc65386727.mp3",
      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-b4465ab7292c",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "That's what I'm afraid of.",
      "audio": "audio/clips/sarah/sarah-bennett-b4465ab7292c.mp3",
      "chapters": [
        1
      ]
    },
    {
