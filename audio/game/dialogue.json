      "chapters": [
        1
      ]
    },
    {
      "lineId": "sarah-bennett-13bbe7381eb1",
      "character": "sarah-bennett",
      "characterName": "Sarah Bennett",
      "kind": "character",
      "text": "Cancel it.",
